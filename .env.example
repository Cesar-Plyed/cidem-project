# Variables de entorno para desarrollo local

Copia este archivo a `.env` y rellena los valores reales antes de levantar el proyecto.

POSTGRES_DB=integrity_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change_me_jwt_secret_32_chars
ADMIN_REGISTRATION_CODE=change_me_admin_code
PROFESOR_REGISTRATION_CODE=change_me_professor_code
CORS_ALLOWED_ORIGINS=http://localhost:4200
API_URL=http://localhost:8080
